# Dashboard runs directly with Node.js. No Docker is used.
# Optional server-side assistant; absent credentials use engine templates.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Put real credentials in Git-ignored .env.local (or exported environment).
# Scripts and Vitest load .env.local automatically. Encode password URL symbols.
# Use a dedicated RailPlan development project, never production/unrelated data.
# Transaction pooler example; copy your actual host/user from Supabase Connect:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
# Supabase connections validate TLS using config/supabase-ca.crt; prepared
# statements are disabled for transaction-pooler compatibility.
